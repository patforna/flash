{
  "compilerOptions": {
    "target": "es2025",
    "lib": ["es2025", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["server", "scripts", "shared", "tests/e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
