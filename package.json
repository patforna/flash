{
  "name": "flash",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "bun --watch server/main.ts",
    "build": "vite build && bun build server/main.ts --target=bun --minify --outfile build/server.js",
    "start": "bun build/server.js",
    "test": "vitest run && bun test ./server ./scripts ./shared",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check --error-on-warnings .",
    "cards:check": "bun scripts/check-cards.ts cards/cards.toml",
    "budget": "bun scripts/budget.ts",
    "verify": "bun run cards:check && bun run typecheck && bun run lint && bun run test && bun run build && bun run budget && bun run e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  }
}
