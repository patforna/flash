# scripts/deploy-do.sh reads .env.deploy (gitignored) from the repo root. Copy this file there and fill it in.
# The domain the app is served on. Its zone (everything after the first label) must be a DigitalOcean domain, since
# the script manages the A record.
DOMAIN=flash.example.com
# The id of an SSH key registered with DigitalOcean: `doctl compute ssh-key list`.
SSH_KEY=12345678
# Optional, with these defaults.
# NAME=flash
# REGION=fra1
# SIZE=s-1vcpu-512mb-10gb
